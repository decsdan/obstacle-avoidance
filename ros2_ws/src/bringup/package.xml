<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>bringup</name>
  <version>2.0.0</version>
  <description>Gazebo worlds, maps, and top-level sim/real launch files for the obstacle-avoidance stack. Hosts W1-W5 SDF worlds and the determinism-aware sim_bringup launch.</description>
  <maintainer email="scheiderd@carleton.edu">daniel</maintainer>
  <license></license>

  <buildtool_depend>ament_cmake</buildtool_depend>

  <exec_depend>nav_server</exec_depend>
  <exec_depend>obstacle_grid</exec_depend>
  <exec_depend>safety_mux</exec_depend>
  <exec_depend>scenario_runner</exec_depend>

  <export>
    <build_type>ament_cmake</build_type>
  </export>
</package>
